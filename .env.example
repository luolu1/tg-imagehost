# ===== Telegram Bot =====
# 从 @BotFather 获取
BOT_TOKEN=123456:ABC-DEF_your_real_token

# 存储频道/群组 ID（可选，但 Web/API 上传必需）。
# 把 bot 拉进群或频道后，在群里 @bot 或发送 /id，它会返回 Chat ID，
# 形如 -1001234567890，填到这里即可。
STORAGE_CHAT_ID=

# 管理员 Telegram 用户 ID，多个用英文逗号分隔。
# 在私聊里给 bot 发送 /id 即可拿到自己的用户 ID。
ADMIN_IDS=

# ===== 对外链接 =====
# 有两种用法：
#
# A) 没有域名（直接用 IP+端口访问）
#    只需填 PUBLIC_HOST 为服务器公网 IP，下面两个留空，
#    程序会自动生成 http://<PUBLIC_HOST>:<WEB_PORT>
#    PUBLIC_HOST=1.2.3.4
#    WEB_PORT=8080
#
# B) 有域名（用 Nginx 反代，可分别配置）
#    页面地址（上传页 / 详情页 / 管理后台）
#    WEB_BASE_URL=https://pic.example.com
#    图片直链地址（可为独立域名，留空则等于 WEB_BASE_URL）
#    IMAGE_BASE_URL=https://img.example.com
#
# 填了域名时以域名为准；两者都留空则回退到 PUBLIC_HOST + WEB_PORT。
PUBLIC_HOST=localhost
WEB_BASE_URL=
IMAGE_BASE_URL=

# Web 服务监听地址（容器内一般用 0.0.0.0）
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ===== 管理后台登录 =====
# 后台无独立账号密码。管理员 = ADMIN_IDS 里的用户，或在后台被设为管理员的用户。
# 他们在用户中心用自己的 API Token 登录（Telegram 里发送 /token 获取），
# 登录后会自动进入管理后台 /admin。普通用户登录则进入自己的用户中心 /my。

# ===== 数据库与缓存 =====
DATABASE_URL=sqlite+aiosqlite:///./data/imagehost.db
CACHE_DIR=./data/cache
# 本地缓存上限（MB），超出后按最久未访问淘汰
CACHE_MAX_MB=2048

# ===== 限制 =====
# 单文件最大体积（MB），Telegram Bot API 上限为 20
MAX_UPLOAD_MB=20
# 每个用户的默认配额（MB），0 表示不限制。
# 可在管理后台「用户管理」或 Telegram 里用 /quota <user_id> <MB> 为单个用户单独设置。
DEFAULT_QUOTA_MB=0
# 群聊中是否处理所有图片（需要关闭 Bot 的 Privacy Mode）
GROUP_PROCESS_ALL=false
